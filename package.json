{
  "name": "@browsers-cli/se-cli",
  "version": "0.2.0",
  "description": "Selenium CLI with token-efficient browser automation for AI agents",
  "license": "Apache-2.0",
  "homepage": "https://se-cli.github.io/se-cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/se-cli/se-cli.git"
  },
  "bugs": {
    "url": "https://github.com/se-cli/se-cli/issues"
  },
  "keywords": [
    "selenium",
    "cli",
    "webdriver",
    "browser-automation",
    "ai-agent",
    "accessibility",
    "aria"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "se-cli": "dist/cli.js",
    "se": "dist/cli.js",
    "selenium-cli": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "cross-env SE_CLI_E2E=1 vitest run tests/integration/",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "selenium-webdriver": "^4.46.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cross-env": "^7.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
